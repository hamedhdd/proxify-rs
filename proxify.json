{
  "proxy_host": "127.0.0.1",
  "proxy_port": 1080,
  "default_action": "direct",
  "rules": [
    {
      "name": "Proxy Specific Corporate Subnet",
      "action": "proxy",
      "target_ips": [
        "198.51.100.*",
        "203.0.113.10"
      ],
      "target_ports": [
        80,
        443,
        8080
      ],
      "target_hosts": [
        "*.corp.example.com"
      ]
    },
    {
      "name": "Direct Localhost Bypass",
      "action": "direct",
      "target_ips": [
        "127.0.0.1",
        "::1"
      ],
      "target_ports": [],
      "target_hosts": [
        "localhost"
      ]
    }
  ]
}